// Seating: the referee decides where a player sits. Players only ask.
//
// A fixed pool of tables with six seats each. join() seats the caller at the table
// where their co-seating history with the players already present is lowest, then
// the emptiest table, then the lowest table id. Nobody chooses a table or a seat.
//
// ponytail: no persistent queue. Seating is decided in the same transaction that
// asks for it, so the only wait is the block. When every seat is taken, join()
// fails and the client asks again. A stored queue arrives with a table pool large
// enough to need it.

import CompactStandardLibrary;

// Seat position: table * 8 + seat. Table ids 0..TABLES-1, seats 0..5.
// Both loops below are unrolled by the compiler, so the pool size is a literal
// in two places (constructor and join). TABLES = 2, SEATS = 6.

// seat position -> player key, or the zero key for an empty seat
export ledger seats: Map<Uint<16>, Bytes<32>>;
// table id -> occupied seat count
export ledger occupancy: Map<Uint<8>, Uint<8>>;
// player key -> seat position; membership means "is seated"
export ledger seated: Map<Bytes<32>, Uint<16>>;
// pair key (both orderings stored) -> times the two have shared a table
export ledger history: Map<Bytes<32>, Uint<32>>;

witness player_secret_key(): Bytes<32>;

constructor() {
  for (const t of 0..2) {
    occupancy.insertDefault(t as Uint<8>);
    for (const s of 0..6) {
      seats.insertDefault(((t * 8) + s) as Uint<16>);
    }
  }
}

export circuit public_key(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "dust.poker:pk:"), sk]);
}

circuit pair_key(a: Bytes<32>, b: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "dust.poker:pair:"), a, b]);
}

circuit shared_count(a: Bytes<32>, b: Bytes<32>): Uint<32> {
  const k = pair_key(a, b);
  return history.member(k) ? history.lookup(k) : 0;
}

circuit caller(): Bytes<32> {
  return disclose(public_key(player_secret_key()));
}

// Seats the caller; returns the seat position.
export circuit join(): Uint<16> {
  const me = caller();
  assert(!seated.member(me), "already seated");

  // Best table: lowest history score, then most free seats, then lowest id.
  const empty = default<Bytes<32>>;
  const no_table = 255 as Uint<8>;
  const worst_score = 4294967295 as Uint<32>;
  const best = for_tables_pick(me, empty, no_table, worst_score);
  assert(best != no_table, "no free seats");

  // First empty seat at that table.
  const pos = first_empty_seat(best, empty);
  seats.insert(pos, me);
  occupancy.insert(best, (occupancy.lookup(best) + 1) as Uint<8>);
  seated.insert(me, pos);

  // Remember who we sat with.
  for (const s of 0..6) {
    const p = ((best * 8) + s) as Uint<16>;
    const other = seats.lookup(p);
    if (other != empty && other != me) {
      history.insert(pair_key(me, other), (shared_count(me, other) + 1) as Uint<32>);
      history.insert(pair_key(other, me), (shared_count(other, me) + 1) as Uint<32>);
    }
  }
  return pos;
}

circuit for_tables_pick(me: Bytes<32>, empty: Bytes<32>, no_table: Uint<8>, worst: Uint<32>): Uint<8> {
  // Unrolled scan over the pool; loops cannot return early, so track the winner in locals.
  const s0 = table_score(0 as Uint<8>, me, empty, worst);
  const s1 = table_score(1 as Uint<8>, me, empty, worst);
  const o0 = occupancy.lookup(0 as Uint<8>);
  const o1 = occupancy.lookup(1 as Uint<8>);
  const t0_ok = s0 != worst;
  const t1_ok = s1 != worst;
  // Table 1 wins only if it is strictly better on score, or equal on score and emptier.
  const pick1 = t1_ok && (!t0_ok || s1 < s0 || (s1 == s0 && o1 < o0));
  return pick1 ? (1 as Uint<8>) : (t0_ok ? (0 as Uint<8>) : no_table);
}

// Sum of co-seating counts with everyone at table t; `worst` when the table is full.
circuit table_score(t: Uint<8>, me: Bytes<32>, empty: Bytes<32>, worst: Uint<32>): Uint<32> {
  const full = occupancy.lookup(t) >= 6;
  const c0 = seat_count(t, 0 as Uint<8>, me, empty);
  const c1 = seat_count(t, 1 as Uint<8>, me, empty);
  const c2 = seat_count(t, 2 as Uint<8>, me, empty);
  const c3 = seat_count(t, 3 as Uint<8>, me, empty);
  const c4 = seat_count(t, 4 as Uint<8>, me, empty);
  const c5 = seat_count(t, 5 as Uint<8>, me, empty);
  const total = (c0 + c1 + c2 + c3 + c4 + c5) as Uint<32>;
  return full ? worst : total;
}

circuit seat_count(t: Uint<8>, s: Uint<8>, me: Bytes<32>, empty: Bytes<32>): Uint<32> {
  const other = seats.lookup(((t * 8) + s) as Uint<16>);
  return other == empty ? 0 : shared_count(me, other);
}

circuit first_empty_seat(t: Uint<8>, empty: Bytes<32>): Uint<16> {
  // Lowest empty seat index; the caller has already checked the table is not full.
  const e0 = seats.lookup(((t * 8) + 0) as Uint<16>) == empty;
  const e1 = seats.lookup(((t * 8) + 1) as Uint<16>) == empty;
  const e2 = seats.lookup(((t * 8) + 2) as Uint<16>) == empty;
  const e3 = seats.lookup(((t * 8) + 3) as Uint<16>) == empty;
  const e4 = seats.lookup(((t * 8) + 4) as Uint<16>) == empty;
  const s = e0 ? 0 : (e1 ? 1 : (e2 ? 2 : (e3 ? 3 : (e4 ? 4 : 5))));
  return ((t * 8) + s) as Uint<16>;
}

// No division in Compact; with two tables a comparison does it.
circuit table_of(pos: Uint<16>): Uint<8> {
  return pos < 8 ? (0 as Uint<8>) : (1 as Uint<8>);
}

// Frees the caller's seat. Stack cash-out arrives with the pot.
export circuit leave(): [] {
  const me = caller();
  assert(seated.member(me), "not seated");
  const pos = seated.lookup(me);
  const t = table_of(pos);
  seats.insert(pos, default<Bytes<32>>);
  occupancy.insert(t, (occupancy.lookup(t) - 1) as Uint<8>);
  seated.remove(me);
}
